# Vercel Deployment Ignore File — HR Vaasthu Production Platform
# Keeps production bundle ultra-light, secure, and prevents data leaks

# ═══ Offline Data & Large Scrap Dumps (Root only) ═══
/data/
/generated-data/
*.sql
*.py

# ═══ Local HTML Dashboards & Offline Dev Scripts ═══
/scripts/*.html
/scripts/*.json
/scripts/*.ts
/scripts/pipeline/
!/scripts/generate-sitemap.js
*.bak
*.tmp
*.log

# ═══ Protect Source & Build Assets ═══
!/src/**
!/api/**
!/public/**

# ═══ Environment Secrets & Credentials ═══
.env
.env.*
.env.local
.env.development
.env.production
.env.staging

# ═══ Development Tools & Configs ═══
.git/
.github/
.vscode/
.idea/
.oxlintrc.json
capacitor.config.ts

# ═══ Build Caches ═══
.vite/
dist-ssr/
node_modules/
